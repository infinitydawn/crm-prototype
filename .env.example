# Copy to .env and fill in. NEVER commit .env.
# Local dev (uses Docker Postgres defaults — works out of the box):

# Backend (server/)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Frontend (client/) — the base URL the browser calls for the API.
# Leave empty locally (uses the Vite /api proxy). Set to your Render URL for prod builds.
VITE_API_URL=

# Production example (set these in Vercel/Render dashboards, NOT locally):
# VITE_API_URL=https://your-backend.onrender.com
# DATABASE_URL=postgresql://neon_user:password@ep-xxxx.region.aws.neon.tech/crm
# CORS_ORIGIN=https://your-frontend.vercel.app
